# Proxy público: lo único expuesto a internet. Lista de permitidos:
# - Keycloak: el realm npd y los recursos del tema; la consola solo con KC_ADMIN_CONSOLE=on
# - Backend: los módulos bajo /api (todos exigen JWT); /actuator queda cerrado
# Todo lo demás responde 404.
{
	admin off
	auto_https off
}

(upstream) {
	reverse_proxy {args[0]} {
		# Railway termina el HTTPS: el servicio debe saber que el usuario entró por https
		header_up X-Forwarded-Proto https
		# IP real del usuario (la pone Railway): bloqueo por fuerza bruta, eventos y logs
		header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
	}
}

:{$PORT:80} {
	# Healthcheck de Railway y monitores externos: responde el proxy, sin tocar a nadie
	handle /healthz {
		respond "ok" 200
	}

	@keycloak path /realms/npd /realms/npd/* /resources/* /robots.txt
	handle @keycloak {
		import upstream {$KEYCLOAK_UPSTREAM}
	}

	@keycloak_admin {
		path /admin/* /realms/master /realms/master/*
		expression `{env.KC_ADMIN_CONSOLE} == "on"`
	}
	handle @keycloak_admin {
		import upstream {$KEYCLOAK_UPSTREAM}
	}

	# Un módulo nuevo del backend se agrega a esta lista
	@backend path_regexp ^/api/(v[0-9]+/)?(planner|history|insights|reports|export|access|notifications)(/|$)
	handle @backend {
		import upstream {$BACKEND_UPSTREAM}
	}

	handle {
		respond 404
	}
}