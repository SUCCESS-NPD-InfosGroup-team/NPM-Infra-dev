# Copy to .env — docker compose reads it automatically.

# Database (shared Postgres). Containers always use postgres:5432;
# DB_PORT is only the host port for IDE runs / DB clients.
DB_PORT=5433
DB_NAME=npd_rp
DB_USER=npd_rp
DB_PASSWORD=change-me

# Host ports
BACKEND_PORT=8080
FRONTEND_PORT=5173
AI_SERVICE_PORT=8000
KEYCLOAK_PORT=8081
PGADMIN_PORT=5050

# Keycloak admin console (http://localhost:8081), only created on the first start
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

JAVA_OPTS=-XX:MaxRAMPercentage=75

# Backend service account for the Keycloak Admin REST API (user creation, SCRUM-93).
# Required. The dev realm (keycloak/npd-realm-dev.json) imports the npd-backend client with this
# same value as its secret, so any value works on a fresh keycloak-data volume.
KEYCLOAK_ADMIN_CLIENT_SECRET=
# Optional overrides (defaults shown)
# KEYCLOAK_ADMIN_CLIENT_ID=npd-backend
# KEYCLOAK_FRONTEND_CLIENT_ID=npd-frontend
# APP_DEV_MODE=true

# Keycloak dev realm (keycloak/npd-realm-dev.json): read as ${VAR} placeholders on the first import
# Required: secret of the npd-ai-service client (any value on a fresh keycloak-data volume)
NPD_AI_SERVICE_CLIENT_SECRET=
# Optional: Google login (Google Cloud Console > Credentials > OAuth client). Ask the team for them
NPD_GOOGLE_CLIENT_ID=
NPD_GOOGLE_CLIENT_SECRET=
# MAILPIT_PORT=8025
